{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "initsystem",
    "uptime",
    "packages",
    "shell",
    "editor",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "physicalmemory",
    "swap",
    "disk",
    "datetime",
    "locale",
    "break",
    "colors"
  ],
  "display": {
    "color": {
      "keys": "{{colors.primary.default.hex}}",
      "title": "{{colors.secondary.default.hex}}"
    }
  }

}
